# Copy to .env and fill. NEVER commit the real .env.

# LLM for the RAG answer layer — Groq on two independent keys (primary + backup
# failover). No third provider; a key left blank is skipped.
GROQ_API_KEY=
GROQ_API_KEY_2=
GEMINI_API_KEY=

# Vector DB (Qdrant free tier)
QDRANT_URL=
QDRANT_API_KEY=

# LinkedIn reach-recovery search (Serper.dev Google Search API, free signup credits)
# https://serper.dev -> sign up -> copy the API key. Leave blank to skip LinkedIn search.
SERPER_API_KEY=

# Optional free-tier email verification
HUNTER_API_KEY=

# Apollo (free tier) — contact-data provider for reach-gap firms. Provider-returned
# values are labeled 'inferred', never 'verified'; email credits are scarce, so
# they're spent only on the strongest records. Leave blank to skip Apollo entirely.
APOLLO_API_KEY=
