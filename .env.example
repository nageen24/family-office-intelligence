# Copy to .env and fill. NEVER commit the real .env.

# LLM + embeddings (free tiers)
GEMINI_API_KEY=
GROQ_API_KEY=

# Vector DB (Qdrant free tier)
QDRANT_URL=
QDRANT_API_KEY=

# Website lookup for enrichment (Google Programmable Search, free 100/day, no card)
# 1. https://programmablesearchengine.google.com -> create engine, "Search the entire web" -> copy the Search engine ID (cx)
# 2. https://console.cloud.google.com -> enable "Custom Search API" -> create an API key
GOOGLE_API_KEY=
GOOGLE_CSE_ID=

# Optional free-tier email verification
HUNTER_API_KEY=
